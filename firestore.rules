// SanctumCare Firestore Security Rules (production-ready)
//
// Critical principles enforced:
// - Every request must be authenticated
// - Every document is scoped to organisationId (or orgId via docOrgId)
// - No cross-tenant reads/writes for tenant data
// - Notes are immutable (update/delete denied)
// - Audit logs protected from non-admin roles (read)
// - Default deny for unknown paths (explicit allow-list below)
// - Org-type differences (care home vs MH vs nursing) stay in app/feature templates; rules enforce tenant only
//
// NOTE: This ruleset assumes `users/{uid}` contains:
// - organisationId (or orgId)
// - role (string like "Admin"/"Manager"/"SUPER_ADMIN") and optional isGlobalAdmin boolean
//
// Identity resolution:
// - If `users/{uid}` exists, organisationId, role, and isGlobalAdmin come ONLY from Firestore (never token).
// - If the profile doc does not exist yet (onboarding), claims on `request.auth.token` are used temporarily.
//
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Safe read: never `get` users/{uid} unless the document exists (avoids rule failures during onboarding).
    function getUserSafe() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function tokenOrgId() {
      return request.auth.token.organisationId != null
        ? request.auth.token.organisationId
        : request.auth.token.orgId;
    }

    function docOrgId(data) {
      return data.organisationId != null ? data.organisationId : data.orgId;
    }

    function getOrgId() {
      let u = getUserSafe();
      return u != null ? docOrgId(u) : tokenOrgId();
    }

    function sameOrganisation(orgId) {
      return isAuthenticated() && orgId != null && getOrgId() == orgId;
    }

    // Always returns a string (empty when no role) so rule types stay consistent.
    function getRole() {
      let u = getUserSafe();
      return u != null
        ? (u.role != null ? string(u.role) : (u.systemRole != null ? string(u.systemRole) : ''))
        : (request.auth.token.role != null ? string(request.auth.token.role) : '');
    }

    function roleUpper() {
      return getRole().upper();
    }

    function isAdmin() {
      return roleUpper() in ['ADMIN', 'MANAGER', 'SUPER_ADMIN', 'GLOBAL_ADMIN'];
    }

    /** Tenant Organisation Admin (or legacy Admin) — structure / directory writes; excludes Manager/Staff. */
    function isOrgAdminRole() {
      let r = getRole();
      return r == 'Organisation Admin' || roleUpper() == 'ADMIN';
    }

    function isGlobalAdmin() {
      let u = getUserSafe();
      return u != null
        ? u.isGlobalAdmin == true
        : request.auth.token.isGlobalAdmin == true;
    }

    function isSuperAdminOrGlobalAdminRole() {
      return roleUpper() in ['SUPER_ADMIN', 'GLOBAL_ADMIN'];
    }

    // Optional: set `isPlatformAdmin: true` on users/{uid} for platform operators (mirrors app context).
    function isPlatformAdminFlag() {
      let u = getUserSafe();
      return u != null && u.isPlatformAdmin == true;
    }

    function canReadOrganisationRoot(orgId) {
      return sameOrganisation(orgId)
        || isSuperAdminOrGlobalAdminRole()
        || isPlatformAdminFlag();
    }

    function organisationDocGroupId(orgId) {
      return get(/databases/$(database)/documents/organisations/$(orgId)).data.groupId;
    }

    function userGroupIdFromProfile() {
      let u = getUserSafe();
      return u != null && u.groupId != null ? u.groupId : null;
    }

    function sameGroupAsOrganisation(orgId) {
      return roleUpper() == 'GROUP_ADMIN'
        && userGroupIdFromProfile() != null
        && orgId != null
        && exists(/databases/$(database)/documents/organisations/$(orgId))
        && organisationDocGroupId(orgId) == userGroupIdFromProfile();
    }

    /** Read tenant-scoped data: home org, platform admin, super admin, or same enterprise group (GROUP_ADMIN). */
    function canAccessTenantData(orgId) {
      return orgId != null && (
        sameOrganisation(orgId)
        || isSuperAdminOrGlobalAdminRole()
        || isPlatformAdminFlag()
        || sameGroupAsOrganisation(orgId)
      );
    }

    function inspectionSessionOrgId(sessionId) {
      return get(/databases/$(database)/documents/inspection_sessions/$(sessionId)).data.organisationId;
    }

    // =========
    // Organisations
    // =========
    match /organisations/{orgId} {
      allow read: if isAuthenticated() && (
        canReadOrganisationRoot(orgId)
        || (roleUpper() == 'GROUP_ADMIN'
          && userGroupIdFromProfile() != null
          && resource.data.groupId == userGroupIdFromProfile())
      );
      allow create, delete: if isAuthenticated() && isGlobalAdmin();
      allow update: if isAuthenticated() && (
        isGlobalAdmin()
        || (sameOrganisation(orgId) && isOrgAdminRole())
      );
    }

    match /groups/{groupId} {
      allow read: if isAuthenticated() && (
        isSuperAdminOrGlobalAdminRole()
        || isPlatformAdminFlag()
        || (roleUpper() == 'GROUP_ADMIN' && userGroupIdFromProfile() == groupId)
      );
      allow create, update, delete: if isAuthenticated()
        && (isSuperAdminOrGlobalAdminRole() || isPlatformAdminFlag());
    }

    // Stage-20 readiness rows (dashboard / compliance). Scoped by parent org id.
    match /organisations/{orgId}/readiness/{readinessId} {
      allow read: if isAuthenticated() && sameOrganisation(orgId);
      allow create, update, delete: if isAuthenticated() && sameOrganisation(orgId) && isAdmin();
    }

    // =========
    // Users
    // =========
    match /users/{userId} {
      // Users can read within their organisation.
      allow read: if isAuthenticated() && sameOrganisation(docOrgId(resource.data));

      // Allow the authenticated user to create their own profile doc.
      // (This keeps onboarding functional; staff/admin-only creation applies to other users.)
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && docOrgId(request.resource.data) != null
        && getOrgId() == docOrgId(request.resource.data);

      // Organisation Admins can create users in their organisation.
      allow create: if isAuthenticated()
        && isOrgAdminRole()
        && sameOrganisation(docOrgId(request.resource.data));

      // Users can only update their own doc; organisation cannot be changed.
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && sameOrganisation(docOrgId(resource.data))
        && docOrgId(request.resource.data) == docOrgId(resource.data);

      // Organisation Admins can manage user docs within their organisation.
      allow update: if isAuthenticated()
        && isOrgAdminRole()
        && sameOrganisation(docOrgId(resource.data))
        && docOrgId(request.resource.data) == docOrgId(resource.data);

      allow delete: if isAuthenticated()
        && isOrgAdminRole()
        && sameOrganisation(docOrgId(resource.data));
    }

    // =========
    // Patients
    // =========
    match /patients/{patientId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);

      allow create: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId);

      allow update, delete: if isAuthenticated()
        && sameOrganisation(resource.data.organisationId)
        && request.resource.data.organisationId == resource.data.organisationId;
    }

    // =========
    // Saved clinical reports (AI Reports export / audit)
    // =========
    match /reports/{reportId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);

      allow create: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId);

      allow update: if false;

      allow delete: if isAuthenticated()
        && resource.data.organisationId != null
        && canAccessTenantData(resource.data.organisationId)
        && isAdmin();
    }

    // =========
    // Notes (immutable; delete only for admins — governance / duplicate cleanup)
    // =========
    match /notes/{noteId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);

      allow create: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId);

      allow update: if false;

      allow delete: if isAuthenticated()
        && resource.data.organisationId != null
        && canAccessTenantData(resource.data.organisationId)
        && (isAdmin() || (roleUpper() == 'GROUP_ADMIN' && sameGroupAsOrganisation(resource.data.organisationId)));
    }

    // =========
    // Note addendums (append-only alternative to editing notes)
    // =========
    match /note_addendums/{addendumId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);

      allow create: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId);

      allow update: if false;
      allow delete: if false;
    }

    // =========
    // Incidents
    // =========
    match /incidents/{incidentId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);

      allow create: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId);

      // Client writes an `incidentId` after creation; allow update within same org.
      allow update: if isAuthenticated()
        && sameOrganisation(resource.data.organisationId)
        && request.resource.data.organisationId == resource.data.organisationId;

      allow delete: if false;
    }

    // =========
    // Patient timeline
    // =========
    match /patient_timeline/{timelineId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);

      allow create: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId);

      allow update: if false;
      allow delete: if false;
    }

    // Legacy alias used by incidentService / carePlanService (same schema as patient_timeline).
    match /patientTimeline/{timelineId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);

      allow create: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId);

      allow update: if false;
      allow delete: if false;
    }

    // =========
    // Services / Hospitals / Wards
    // (Needed for onboarding + tenant setup flows.)
    // =========
    match /services/{serviceId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);
      allow create, update: if isAuthenticated()
        && isOrgAdminRole()
        && sameOrganisation(request.resource.data.organisationId);
      allow delete: if false;
    }

    match /hospitals/{hospitalId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);
      allow create, update: if isAuthenticated()
        && isOrgAdminRole()
        && sameOrganisation(request.resource.data.organisationId);
      allow delete: if false;
    }

    match /wards/{wardId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);
      allow create, update: if isAuthenticated()
        && isOrgAdminRole()
        && sameOrganisation(request.resource.data.organisationId);
      allow delete: if false;
    }

    // =========
    // Audit logs
    // =========
    match /audit_logs/{logId} {
      allow read: if isAuthenticated()
        && isAdmin()
        && sameOrganisation(resource.data.organisationId);

      // Allow creation for authenticated users, but scoped to their organisation.
      allow create: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId);

      allow update, delete: if false;
    }

    // Legacy audit sink
    match /auditLogs/{logId} {
      allow read: if isAuthenticated()
        && isAdmin()
        && sameOrganisation(resource.data.organisationId);

      allow create: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId);

      allow update, delete: if false;
    }

    // =========
    // Inspection reports (if/when stored)
    // =========
    match /inspection_reports/{reportId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);
      allow create: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId);
      allow update, delete: if false;
    }

    // =========
    // Subscriptions
    // =========
    match /subscriptions/{subId} {
      allow read: if isAuthenticated()
        && resource.data.organisationId != null
        && sameOrganisation(resource.data.organisationId);

      allow create: if isAuthenticated()
        && docOrgId(request.resource.data) != null
        && sameOrganisation(docOrgId(request.resource.data))
        && isAdmin();

      allow update: if isAuthenticated()
        && docOrgId(resource.data) != null
        && sameOrganisation(docOrgId(resource.data))
        && docOrgId(request.resource.data) == docOrgId(resource.data)
        && isAdmin();

      allow delete: if isAuthenticated() && isGlobalAdmin();
    }

    // =========
    // Documents (managed uploads: category, expiry, etc.)
    // =========
    match /documents/{documentId} {
      allow read: if isAuthenticated() && sameOrganisation(docOrgId(resource.data));
      allow create: if isAuthenticated()
        && docOrgId(request.resource.data) != null
        && sameOrganisation(docOrgId(request.resource.data));
      allow update: if isAuthenticated()
        && sameOrganisation(docOrgId(resource.data))
        && docOrgId(request.resource.data) == docOrgId(resource.data);
    }

    // =========
    // Evidence (CQC domain uploads)
    // =========
    match /evidence/{evidenceId} {
      allow read: if isAuthenticated() && sameOrganisation(docOrgId(resource.data));
      allow create: if isAuthenticated()
        && docOrgId(request.resource.data) != null
        && sameOrganisation(docOrgId(request.resource.data));
      allow update: if isAuthenticated()
        && sameOrganisation(docOrgId(resource.data))
        && docOrgId(request.resource.data) == docOrgId(resource.data);
    }

    // =========
    // Behaviour tracking (linked to clinical notes)
    // =========
    match /behaviours/{behaviourId} {
      allow read: if isAuthenticated() && sameOrganisation(docOrgId(resource.data));
      allow create: if isAuthenticated()
        && docOrgId(request.resource.data) != null
        && sameOrganisation(docOrgId(request.resource.data));
      allow update: if isAuthenticated()
        && sameOrganisation(docOrgId(resource.data))
        && docOrgId(request.resource.data) == docOrgId(resource.data);
    }

    // =========
    // Risk alerts (derived from notes / risk engine)
    // =========
    match /risk_alerts/{alertId} {
      allow read: if isAuthenticated() && sameOrganisation(docOrgId(resource.data));
      allow create: if isAuthenticated()
        && docOrgId(request.resource.data) != null
        && sameOrganisation(docOrgId(request.resource.data));
      allow update: if isAuthenticated()
        && sameOrganisation(docOrgId(resource.data))
        && docOrgId(request.resource.data) == docOrgId(resource.data);
    }

    // =========
    // Staff training / competency records
    // =========
    match /staff_training/{trainingId} {
      allow read: if isAuthenticated() && sameOrganisation(docOrgId(resource.data));
      allow create: if isAuthenticated()
        && docOrgId(request.resource.data) != null
        && sameOrganisation(docOrgId(request.resource.data));
      allow update: if isAuthenticated()
        && sameOrganisation(docOrgId(resource.data))
        && docOrgId(request.resource.data) == docOrgId(resource.data);
    }

    // =========
    // Care plans (structured + AI drafts) and version history
    // =========
    match /care_plans/{carePlanId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);
      allow create: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId);
      allow update, delete: if isAuthenticated()
        && sameOrganisation(resource.data.organisationId)
        && request.resource.data.organisationId == resource.data.organisationId;
    }

    match /care_plan_versions/{versionId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);
      allow create: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId);
      allow update, delete: if isAuthenticated()
        && sameOrganisation(resource.data.organisationId)
        && request.resource.data.organisationId == resource.data.organisationId;
    }

    match /carePlans/{carePlanId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);
      allow create: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId);
      allow update, delete: if isAuthenticated()
        && sameOrganisation(resource.data.organisationId)
        && request.resource.data.organisationId == resource.data.organisationId;
    }

    // =========
    // Compliance engine + governance (all queries filter by organisationId in app code)
    // =========
    match /compliance_scores/{scoreId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);
      allow create, update: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId);
      allow delete: if false;
    }

    match /compliance_domains/{domainId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);
      allow create: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId)
        && isAdmin();
      allow update: if isAuthenticated()
        && sameOrganisation(resource.data.organisationId)
        && request.resource.data.organisationId == resource.data.organisationId;
      allow delete: if false;
    }

    match /compliance_actions/{actionId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);
      allow create: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId);
      allow update: if isAuthenticated()
        && sameOrganisation(resource.data.organisationId)
        && request.resource.data.organisationId == resource.data.organisationId;
      allow delete: if false;
    }

    match /compliance_stats/{statsId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);
      allow create, update: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId);
      allow delete: if false;
    }

    // =========
    // Policies / evidence file metadata / per-domain counts (document module)
    // =========
    match /policies/{policyId} {
      allow read: if isAuthenticated() && sameOrganisation(docOrgId(resource.data));
      allow create: if isAuthenticated()
        && docOrgId(request.resource.data) != null
        && isAdmin()
        && sameOrganisation(docOrgId(request.resource.data));
      allow update: if isAuthenticated()
        && isAdmin()
        && sameOrganisation(docOrgId(resource.data))
        && docOrgId(request.resource.data) == docOrgId(resource.data);
      allow delete: if isAuthenticated()
        && isAdmin()
        && sameOrganisation(docOrgId(resource.data));
    }

    match /evidence_documents/{evidenceDocId} {
      allow read: if isAuthenticated() && sameOrganisation(docOrgId(resource.data));
      allow create: if isAuthenticated()
        && docOrgId(request.resource.data) != null
        && sameOrganisation(docOrgId(request.resource.data));
      allow update: if isAuthenticated()
        && sameOrganisation(docOrgId(resource.data))
        && docOrgId(request.resource.data) == docOrgId(resource.data);
      allow delete: if false;
    }

    match /document_stats/{statId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);
      allow create, update: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId);
      allow delete: if false;
    }

    // =========
    // Notifications (in-app)
    // =========
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);
      allow create: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId);
      allow update: if isAuthenticated()
        && sameOrganisation(resource.data.organisationId)
        && request.resource.data.organisationId == resource.data.organisationId;
      allow delete: if false;
    }

    // =========
    // CQC scores + inspection simulations (dashboard)
    // =========
    match /cqcScores/{rowId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);
      allow create, update: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId);
      allow delete: if false;
    }

    match /inspection_simulations/{simId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);
      allow create: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId);
      allow update, delete: if false;
    }

    match /inspection_scores/{scoreId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);
      allow create: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId);
      allow update, delete: if false;
    }

    // Care tasks (per patient, tenant-scoped)
    match /tasks/{taskId} {
      allow read: if isAuthenticated()
        && sameOrganisation(resource.data.organisationId);

      allow create: if isAuthenticated()
        && request.resource.data.organisationId != null
        && request.resource.data.patientId != null
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.description is string
        && request.resource.data.status == "pending"
        && request.resource.data.shift in ["morning", "afternoon", "night"]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.dueAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.completedAt == null
        && request.resource.data.completedBy == null
        && (request.resource.data.assignedTo == null || request.resource.data.assignedTo is string)
        && sameOrganisation(request.resource.data.organisationId);

      allow update: if isAuthenticated()
        && sameOrganisation(resource.data.organisationId)
        && resource.data.status == "pending"
        && request.resource.data.organisationId == resource.data.organisationId
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.title == resource.data.title
        && request.resource.data.description == resource.data.description
        && request.resource.data.shift == resource.data.shift
        && request.resource.data.dueAt == resource.data.dueAt
        && request.resource.data.assignedTo == resource.data.assignedTo
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.status == "completed"
        && request.resource.data.completedAt is timestamp
        && request.resource.data.completedBy == request.auth.uid;

      allow delete: if false;
    }

    // =========
    // Platform admin membership lookup (query: where userId == request.auth.uid)
    // =========
    match /platform_admins/{docId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // =========
    // Inspection workflow (sessions hold organisationId; responses link to session)
    // =========
    match /inspection_questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /inspection_sessions/{sessionId} {
      allow read: if isAuthenticated() && canAccessTenantData(resource.data.organisationId);
      allow create: if isAuthenticated()
        && request.resource.data.organisationId != null
        && sameOrganisation(request.resource.data.organisationId);
      allow update: if isAuthenticated()
        && sameOrganisation(resource.data.organisationId)
        && request.resource.data.organisationId == resource.data.organisationId;
      allow delete: if false;
    }

    match /inspection_responses/{responseId} {
      allow read: if isAuthenticated()
        && resource.data.sessionId != null
        && sameOrganisation(inspectionSessionOrgId(resource.data.sessionId));
      allow create: if isAuthenticated()
        && request.resource.data.sessionId != null
        && sameOrganisation(inspectionSessionOrgId(request.resource.data.sessionId));
      allow update: if isAuthenticated()
        && resource.data.sessionId != null
        && request.resource.data.sessionId != null
        && sameOrganisation(inspectionSessionOrgId(resource.data.sessionId))
        && sameOrganisation(inspectionSessionOrgId(request.resource.data.sessionId));
      allow delete: if false;
    }

    // =========
    // Fail-safe: deny everything else.
    // =========
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
