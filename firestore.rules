// Multi-tenant isolation: authenticated users only; document organisationId must match profile org.
// Note: `resource` is not available on create — create uses request.resource only.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userOrg() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return u.data.organisationId != null
        ? u.data.organisationId
        : u.data.orgId;
    }

    function sameOrg(resource) {
      return resource.data.organisationId == userOrg();
    }

    // Token + profile: allow when document org matches JWT claim or Firestore user profile org.
    function tenantMatches(resource) {
      return resource.data.organisationId != null
        && (
          resource.data.organisationId == request.auth.token.organisationId
          || sameOrg(resource)
        );
    }

    // Own profile: required for client bootstrap (org claim may lag; rules read Firestore users/{uid}).
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /patients/{patientId} {
      allow read: if isAuthenticated() && tenantMatches(resource);
      allow create: if isAuthenticated()
        && request.resource.data.organisationId != null
        && (
          request.resource.data.organisationId == request.auth.token.organisationId
          || request.resource.data.organisationId == userOrg()
        );
      allow update, delete: if isAuthenticated()
        && tenantMatches(resource)
        && request.resource.data.organisationId == userOrg();
    }

    match /notes/{noteId} {
      allow read: if isAuthenticated() && tenantMatches(resource);
      allow create: if isAuthenticated()
        && request.resource.data.organisationId != null
        && (
          request.resource.data.organisationId == request.auth.token.organisationId
          || request.resource.data.organisationId == userOrg()
        );
      allow update, delete: if isAuthenticated()
        && tenantMatches(resource)
        && request.resource.data.organisationId == userOrg();
    }

    match /{collection}/{docId} {
      allow read: if isAuthenticated() && sameOrg(resource);
      allow create: if isAuthenticated() && request.resource.data.organisationId == userOrg();
      allow update, delete: if isAuthenticated()
        && sameOrg(resource)
        && request.resource.data.organisationId == userOrg();
    }
  }
}
