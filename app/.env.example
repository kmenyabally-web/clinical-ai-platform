# Copy to `.env` locally (never commit `.env`).
# Vite exposes only variables prefixed with VITE_ to client code — keep keys out of source control.

VITE_GEMINI_API_KEY=your_api_key_here

# Optional: Gemini model id (default: gemini-1.5-flash). Use gemini-1.5-pro for higher quality.
# VITE_GEMINI_MODEL=gemini-1.5-pro

# Set to true to tag tenant writes with isTest (safe mode).
VITE_SAFE_MODE=false
